# C2 Banking System — environment variable NAMES with fake placeholders only.
# Copy to .env.local (gitignored) and fill real values locally; set deployed values in the host dashboard.

# Public: canonical site URL (Production only; leave unset for Previews)
NEXT_PUBLIC_SITE_URL=https://example.com

# Public: Formspree form endpoint for the "Open an account" waitlist (D6).
# When unset, the form is shown but submission is disabled with an honest message.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
